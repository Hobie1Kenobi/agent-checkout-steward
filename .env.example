# Copy to .env and fill in. Never commit .env.
# Sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
# Leave the client id and secret empty to run the desk and the demo in mock mode.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Orders v2 sandbox host. Live hosts are rejected.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# auto: sandbox when both credentials are set, otherwise mock.
# mock: never call PayPal, even if credentials are present.
# sandbox: require credentials and call the sandbox.
CHECKOUT_MODE=auto

# Optional absolute origin for PayPal return_url and cancel_url.
# Default is http://127.0.0.1:$PORT. Set an https origin if the sandbox
# rejects an http return URL. The buyer redirect is handled by the browser.
CHECKOUT_PUBLIC_BASE=

# Planner. auto uses the Vercel AI Gateway when AI_GATEWAY_API_KEY is set,
# otherwise an OpenAI-compatible server when OPENAI_BASE_URL is set,
# otherwise Anthropic when ANTHROPIC_API_KEY is set,
# otherwise the deterministic fallback (no network, no AI key).
# gateway | openai | anthropic | none also work.
LLM_PROVIDER=auto

# Vercel AI Gateway via the AI SDK. Model ids are provider/model from
# https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-2.5-flash

# OpenAI-compatible chat completions, including Ollama:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1

# Optional direct Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=4320
